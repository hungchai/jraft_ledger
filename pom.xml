<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.tomma8</groupId>
    <artifactId>ledger-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Ledger Platform</name>
    <description>Next-Gen Internal Ledger Platform — Raft + CQRS</description>

    <modules>
        <module>ledger-core</module>
        <module>ledger-dao</module>
        <module>ledger-service</module>
        <module>ledger-restful</module>
        <module>ledger-feign</module>
        <module>ledger-projection</module>
        <module>ledger-client-sdk</module>
        <module>ledger-perf-tests</module>
        <module>ledger-raft-ratis</module>
    </modules>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.4</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- SOFAJRaft -->
        <sofa.jraft.version>1.4.0</sofa.jraft.version>

        <!-- Apache Ratis (alternative consensus engine — POC, see ADR-003) -->
        <ratis.version>3.1.0</ratis.version>

        <!-- SOFA Common Tools (must be 2.x for Spring Boot 3.x logback 1.5 compatibility;
             sofa-common-tools 1.0.x uses ContextInitializer.configureByResource(URL)
             which was removed in logback 1.4.9/1.5.x → NoSuchMethodError at runtime) -->
        <sofa.common.tools.version>2.1.1</sofa.common.tools.version>

        <!-- RocksDB -->
        <rocksdb.version>9.10.0</rocksdb.version>

        <!-- MyBatis -->
        <mybatis.spring.version>3.0.4</mybatis.spring.version>

        <!-- Spring Cloud (OpenFeign) -->
        <spring.cloud.version>2024.0.1</spring.cloud.version>

        <!-- Test -->
        <testcontainers.version>1.20.6</testcontainers.version>
        <assertj.version>3.27.3</assertj.version>

        <!-- ShardingSphere -->
        <shardingsphere.version>5.5.1</shardingsphere.version>

        <!-- Misc -->
        <protobuf.version>3.25.5</protobuf.version>

        <!-- Caffeine: high-perf, near-zero-allocation cache for the projection date LRU. -->
        <caffeine.version>3.1.8</caffeine.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>com.tomma8</groupId>
                <artifactId>ledger-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tomma8</groupId>
                <artifactId>ledger-dao</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tomma8</groupId>
                <artifactId>ledger-service</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.tomma8</groupId>
                <artifactId>ledger-projection</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tomma8</groupId>
                <artifactId>ledger-client-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tomma8</groupId>
                <artifactId>ledger-perf-tests</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tomma8</groupId>
                <artifactId>ledger-raft-ratis</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Apache Ratis (alternative consensus engine — POC) -->
            <dependency>
                <groupId>org.apache.ratis</groupId>
                <artifactId>ratis-server</artifactId>
                <version>${ratis.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.ratis</groupId>
                <artifactId>ratis-grpc</artifactId>
                <version>${ratis.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.ratis</groupId>
                <artifactId>ratis-client</artifactId>
                <version>${ratis.version}</version>
            </dependency>
            <!-- Runtime metrics SPI impl — required at server start (MetricRegistriesImpl) -->
            <dependency>
                <groupId>org.apache.ratis</groupId>
                <artifactId>ratis-metrics-default</artifactId>
                <version>${ratis.version}</version>
            </dependency>

            <!-- SOFAJRaft -->
            <dependency>
                <groupId>com.alipay.sofa</groupId>
                <artifactId>jraft-core</artifactId>
                <version>${sofa.jraft.version}</version>
            </dependency>

            <!-- Override sofa-common-tools transitive dep from jraft-core
                 (which pins 1.0.12 incompatible with logback 1.5.x) -->
            <dependency>
                <groupId>com.alipay.sofa.common</groupId>
                <artifactId>sofa-common-tools</artifactId>
                <version>${sofa.common.tools.version}</version>
            </dependency>

            <!-- RocksDB -->
            <dependency>
                <groupId>org.rocksdb</groupId>
                <artifactId>rocksdbjni</artifactId>
                <version>${rocksdb.version}</version>
            </dependency>

            <!-- MyBatis Spring Boot -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis.spring.version}</version>
            </dependency>

            <!-- Spring Cloud BOM (OpenFeign) -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring.cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ShardingSphere JDBC -->
            <dependency>
                <groupId>org.apache.shardingsphere</groupId>
                <artifactId>shardingsphere-jdbc</artifactId>
                <version>${shardingsphere.version}</version>
            </dependency>

            <!-- Protobuf -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>

            <!-- Caffeine: bounded LRU cache (replaces Collections.synchronizedMap
                 + LinkedHashMap for the projection DATE_CACHE — lock-free, lower
                 allocation rate, O(1) evict). -->
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${caffeine.version}</version>
            </dependency>

            <!-- Test -->
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>21</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- SOFAJRaft + Netty reflect into JDK internals (SegmentList →
                             java.util.ArrayList.elementData, ThrowUtil → java.lang.Throwable.cause,
                             Netty → nio buffers); JDK 17+ strong encapsulation needs these add-opens. -->
                        <argLine>-XX:+EnableDynamicAgentLoading
                            --add-opens=java.base/java.util=ALL-UNNAMED
                            --add-opens=java.base/java.lang=ALL-UNNAMED
                            --add-opens=java.base/java.nio=ALL-UNNAMED
                            --add-opens=java.base/sun.nio.ch=ALL-UNNAMED</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
