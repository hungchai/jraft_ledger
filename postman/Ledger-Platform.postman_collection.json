    {
      "name": "Manual Adjustment",
      "item": [
        {
          "name": "Create Adjustment Draft",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.draftId) pm.collectionVariables.set('draft_id', json.draftId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{request_id}}\",\n  \"makerId\": \"maker-001\",\n  \"legs\": [{\n    \"legId\": \"leg-1\",\n    \"postingType\": \"ADJUSTMENT\",\n    \"lines\": [\n      { \"accountId\": \"CLIENT_ACC_001\", \"balanceType\": \"AVAILABLE_BALANCE\", \"position\": \"CURRENT\", \"currency\": \"USD\", \"entryType\": \"CREDIT\", \"amount\": \"100.00\", \"description\": \"Adjustment credit\" },\n      { \"accountId\": \"COMPANY_FX_ACC\", \"balanceType\": \"AVAILABLE_BALANCE\", \"position\": \"CURRENT\", \"currency\": \"USD\", \"entryType\": \"DEBIT\", \"amount\": \"100.00\", \"description\": \"Adjustment debit\" }\n    ]\n  }]\n}"
            },
            "url": { "raw": "{{base_url}}/ledger/adjustments/drafts", "host": ["{{base_url}}"], "path": ["ledger", "adjustments", "drafts"] }
          }
        },
        {
          "name": "Approve Adjustment Draft",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"checkerId\": \"checker-001\",\n  \"approveRequestId\": \"{{request_id}}\"\n}" },
            "url": { "raw": "{{base_url}}/ledger/adjustments/drafts/{{draft_id}}/approve", "host": ["{{base_url}}"], "path": ["ledger", "adjustments", "drafts", "{{draft_id}}", "approve"] }
          }
        },
        {
          "name": "Reject Adjustment Draft",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"checkerId\": \"checker-001\",\n  \"reason\": \"Not valid\"\n}" },
            "url": { "raw": "{{base_url}}/ledger/adjustments/drafts/{{draft_id}}/reject", "host": ["{{base_url}}"], "path": ["ledger", "adjustments", "drafts", "{{draft_id}}", "reject"] }
          }
        }
      ]
    },
