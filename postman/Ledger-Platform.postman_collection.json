    {
      "name": "Full Flow (Run in Order)",
      "item": [
        {
          "name": "STEP 1: Create Accounts",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"flow-001\",\n  \"accountId\": \"ALICE_ACC\",\n  \"accountType\": \"CLIENT\",\n  \"displayName\": \"Alice\",\n  \"ownerId\": \"ALICE\",\n  \"balanceInitializations\": [\n    { \"balanceType\": \"AVAILABLE_BALANCE\", \"currency\": \"USD\" }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/ledger/accounts", "host": ["{{base_url}}"], "path": ["ledger", "accounts"] }
          }
        },
        {
          "name": "STEP 2: Create Counterparty Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"flow-002\",\n  \"accountId\": \"BANK_ACC\",\n  \"accountType\": \"COMPANY\",\n  \"displayName\": \"Bank\",\n  \"balanceInitializations\": [\n    { \"balanceType\": \"AVAILABLE_BALANCE\", \"currency\": \"USD\" }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/ledger/accounts", "host": ["{{base_url}}"], "path": ["ledger", "accounts"] }
          }
        },
        {
          "name": "STEP 3: Transfer 1000 USD to Alice",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"flow-003\",\n  \"businessEventType\": \"TRANSFER\",\n  \"businessEventRef\": \"FLOW-001\",\n  \"valueDate\": \"2026-05-18\",\n  \"legs\": [{\n    \"legId\": \"leg-1\",\n    \"postingType\": \"TRANSFER\",\n    \"lines\": [\n      { \"accountId\": \"BANK_ACC\", \"balanceType\": \"AVAILABLE_BALANCE\", \"position\": \"CURRENT\", \"currency\": \"USD\", \"entryType\": \"DEBIT\", \"amount\": \"1000.00\" },\n      { \"accountId\": \"ALICE_ACC\", \"balanceType\": \"AVAILABLE_BALANCE\", \"position\": \"CURRENT\", \"currency\": \"USD\", \"entryType\": \"CREDIT\", \"amount\": \"1000.00\" }\n    ]\n  }]\n}"
            },
            "url": { "raw": "{{base_url}}/ledger/postings", "host": ["{{base_url}}"], "path": ["ledger", "postings"] }
          }
        },
        {
          "name": "STEP 4: Check Alice Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ledger/balances?accountId=ALICE_ACC&balanceType=AVAILABLE_BALANCE&currency=USD",
              "host": ["{{base_url}}"], "path": ["ledger", "balances"],
              "query": [
                { "key": "accountId", "value": "ALICE_ACC" },
                { "key": "balanceType", "value": "AVAILABLE_BALANCE" },
                { "key": "currency", "value": "USD" }
              ]
            }
          }
        }
      ]
