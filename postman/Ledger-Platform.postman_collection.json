{
  "info": {
    "name": "Ledger Platform API",
    "description": "Next-Gen Internal Ledger Platform — Raft + CQRS\n\nBase URL: http://localhost:8081\n\nVariables:\n- {{base_url}} = http://localhost:8081\n- {{node1}} = http://localhost:8081\n- {{node2}} = http://localhost:8082\n- {{node3}} = http://localhost:8083",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8081" },
    { "key": "account_id", "value": "CLIENT_ACC_001" },
    { "key": "company_id", "value": "COMPANY_FX_ACC" },
    { "key": "request_id", "value": "{{$guid}}" },
    { "key": "journal_id", "value": "" },
    { "key": "draft_id", "value": "" },
    { "key": "leader_url", "value": "http://localhost:8081" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Create Client Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status COMPLETED', () => pm.expect(pm.response.json().status).to.eql('COMPLETED'));",
                  "pm.collectionVariables.set('account_id', 'CLIENT_ACC_001');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{request_id}}\",\n  \"accountId\": \"CLIENT_ACC_001\",\n  \"accountType\": \"CLIENT\",\n  \"displayName\": \"Client Account 001\",\n  \"ownerId\": \"CUST-001\",\n  \"balanceInitializations\": [\n    { \"balanceType\": \"AVAILABLE_BALANCE\", \"currency\": \"USD\" },\n    { \"balanceType\": \"AVAILABLE_BALANCE\", \"currency\": \"HKD\" }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/ledger/accounts", "host": ["{{base_url}}"], "path": ["ledger", "accounts"] }
          }
        },
        {
          "name": "Create Company Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{request_id}}\",\n  \"accountId\": \"COMPANY_TEST_001\",\n  \"accountType\": \"COMPANY\",\n  \"displayName\": \"Company Test Account\",\n  \"balanceInitializations\": [\n    { \"balanceType\": \"AVAILABLE_BALANCE\", \"currency\": \"USD\" }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/ledger/accounts", "host": ["{{base_url}}"], "path": ["ledger", "accounts"] }
          }
        },
        {
          "name": "Freeze Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"requestId\": \"{{request_id}}\"\n}" },
            "url": { "raw": "{{base_url}}/ledger/accounts/{{account_id}}/freeze", "host": ["{{base_url}}"], "path": ["ledger", "accounts", "{{account_id}}", "freeze"] }
          }
        },
        {
          "name": "Unfreeze Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"requestId\": \"{{request_id}}\"\n}" },
            "url": { "raw": "{{base_url}}/ledger/accounts/{{account_id}}/unfreeze", "host": ["{{base_url}}"], "path": ["ledger", "accounts", "{{account_id}}", "unfreeze"] }
          }
        },
        {
          "name": "Close Account (must have zero balance)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"requestId\": \"{{request_id}}\"\n}" },
            "url": { "raw": "{{base_url}}/ledger/accounts/{{account_id}}/close", "host": ["{{base_url}}"], "path": ["ledger", "accounts", "{{account_id}}", "close"] }
          }
        },
        {
          "name": "Add Balance Type",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"balanceType\": \"BROKERAGE_BALANCE\",\n  \"currency\": \"USD\",\n  \"requestId\": \"{{request_id}}\"\n}" },
            "url": { "raw": "{{base_url}}/ledger/accounts/{{account_id}}/balance-types", "host": ["{{base_url}}"], "path": ["ledger", "accounts", "{{account_id}}", "balance-types"] }
          }
        }
      ]
    },
    {
      "name": "Posting",
      "item": [
        {
          "name": "★ Seed Company Account ★ (run this FIRST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Seed COMPLETED', () => pm.expect(json.status).to.eql('COMPLETED'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"seed-company-001\",\n  \"businessEventType\": \"CAPITAL_INJECTION\",\n  \"businessEventRef\": \"SEED-001\",\n  \"valueDate\": \"2026-05-18\",\n  \"legs\": [{\n    \"legId\": \"leg-1\",\n    \"postingType\": \"CAPITAL\",\n    \"amount\": \"100000.00\",\n    \"currency\": \"USD\",\n    \"lines\": [\n      { \"accountId\": \"COMPANY_FX_ACC\", \"balanceType\": \"AVAILABLE_BALANCE\", \"position\": \"CURRENT\", \"entryType\": \"CREDIT\", \"description\": \"Seed capital\" }\n    ]\n  }]\n}"
            },
            "url": { "raw": "{{base_url}}/ledger/postings", "host": ["{{base_url}}"], "path": ["ledger", "postings"] }
          }
        },
        {
          "name": "Deposit (Company→Client)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Status COMPLETED', () => pm.expect(json.status).to.eql('COMPLETED'));",
                  "if (json.journalId) pm.collectionVariables.set('journal_id', json.journalId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{request_id}}\",\n  \"businessEventType\": \"DEPOSIT\",\n  \"businessEventRef\": \"DEP-{{$timestamp}}\",\n  \"valueDate\": \"2026-05-18\",\n  \"legs\": [{\n    \"legId\": \"leg-1\",\n    \"postingType\": \"DEPOSIT\",\n    \"amount\": \"1000.00\",\n    \"currency\": \"USD\",\n    \"lines\": [\n      { \"accountId\": \"COMPANY_FX_ACC\", \"balanceType\": \"AVAILABLE_BALANCE\", \"position\": \"CURRENT\", \"entryType\": \"DEBIT\", \"description\": \"Company funds\" },\n      { \"accountId\": \"CLIENT_ACC_001\", \"balanceType\": \"AVAILABLE_BALANCE\", \"position\": \"CURRENT\", \"entryType\": \"CREDIT\", \"description\": \"Client deposit\" }\n    ]\n  }]\n}"
            },
            "url": { "raw": "{{base_url}}/ledger/postings", "host": ["{{base_url}}"], "path": ["ledger", "postings"] }
          }
        },
        {
          "name": "Withdraw (Client→Company)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{request_id}}\",\n  \"businessEventType\": \"WITHDRAWAL\",\n  \"businessEventRef\": \"WTH-{{$timestamp}}\",\n  \"valueDate\": \"2026-05-18\",\n  \"legs\": [{\n    \"legId\": \"leg-1\",\n    \"postingType\": \"WITHDRAWAL\",\n    \"amount\": \"300.00\",\n    \"currency\": \"USD\",\n    \"lines\": [\n      { \"accountId\": \"CLIENT_ACC_001\", \"balanceType\": \"AVAILABLE_BALANCE\", \"position\": \"CURRENT\", \"entryType\": \"DEBIT\", \"description\": \"Client withdrawal\" },\n      { \"accountId\": \"COMPANY_FX_ACC\", \"balanceType\": \"AVAILABLE_BALANCE\", \"position\": \"CURRENT\", \"entryType\": \"CREDIT\", \"description\": \"Company receive\" }\n    ]\n  }]\n}"
            },
            "url": { "raw": "{{base_url}}/ledger/postings", "host": ["{{base_url}}"], "path": ["ledger", "postings"] }
          }
        },
        {
          "name": "Idempotent Resend (same requestId)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"idem-test-001\",\n  \"businessEventType\": \"DEPOSIT\",\n  \"businessEventRef\": \"DEP-IDEM\",\n  \"valueDate\": \"2026-05-18\",\n  \"legs\": [{\n    \"legId\": \"leg-1\",\n    \"postingType\": \"DEPOSIT\",\n    \"amount\": \"10.00\",\n    \"currency\": \"USD\",\n    \"lines\": [\n      { \"accountId\": \"COMPANY_FX_ACC\", \"balanceType\": \"AVAILABLE_BALANCE\", \"position\": \"CURRENT\", \"entryType\": \"DEBIT\", \"description\": \"Idem\" },\n      { \"accountId\": \"CLIENT_ACC_001\", \"balanceType\": \"AVAILABLE_BALANCE\", \"position\": \"CURRENT\", \"entryType\": \"CREDIT\", \"description\": \"Idem\" }\n    ]\n  }]\n}"
            },
            "url": { "raw": "{{base_url}}/ledger/postings", "host": ["{{base_url}}"], "path": ["ledger", "postings"] }
          }
        },
        {
          "name": "Unbalanced Posting (400 error)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{request_id}}\",\n  \"businessEventType\": \"TEST\",\n  \"businessEventRef\": \"UNBAL-001\",\n  \"valueDate\": \"2026-05-18\",\n  \"legs\": [{\n    \"legId\": \"leg-1\",\n    \"postingType\": \"TEST\",\n    \"amount\": \"100.00\",\n    \"currency\": \"USD\",\n    \"lines\": [\n      { \"accountId\": \"CLIENT_ACC_001\", \"balanceType\": \"AVAILABLE_BALANCE\", \"position\": \"CURRENT\", \"entryType\": \"DEBIT\", \"description\": \"Test unbalanced - this will be rejected\" }\n    ]\n  }]\n}"
            },
            "url": { "raw": "{{base_url}}/ledger/postings", "host": ["{{base_url}}"], "path": ["ledger", "postings"] }
          }
        },
        {
          "name": "Insufficient Balance (400 error)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{request_id}}\",\n  \"businessEventType\": \"TEST\",\n  \"businessEventRef\": \"INSF-001\",\n  \"valueDate\": \"2026-05-18\",\n  \"legs\": [{\n    \"legId\": \"leg-1\",\n    \"postingType\": \"TEST\",\n    \"lines\": [\n      { \"accountId\": \"CLIENT_ACC_001\", \"balanceType\": \"AVAILABLE_BALANCE\", \"position\": \"CURRENT\", \"currency\": \"USD\", \"entryType\": \"DEBIT\", \"amount\": \"999999.00\" },\n      { \"accountId\": \"COMPANY_FX_ACC\", \"balanceType\": \"AVAILABLE_BALANCE\", \"position\": \"CURRENT\", \"currency\": \"USD\", \"entryType\": \"CREDIT\", \"amount\": \"999999.00\" }\n    ]\n  }]\n}"
            },
            "url": { "raw": "{{base_url}}/ledger/postings", "host": ["{{base_url}}"], "path": ["ledger", "postings"] }
          }
        }
      ]
    },
    {
      "name": "Balance Query",
      "item": [
        {
          "name": "Get Balance (aggregated positions)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ledger/balances?accountId={{account_id}}&balanceType=AVAILABLE_BALANCE&currency=USD",
              "host": ["{{base_url}}"], "path": ["ledger", "balances"],
              "query": [
                { "key": "accountId", "value": "{{account_id}}" },
                { "key": "balanceType", "value": "AVAILABLE_BALANCE" },
                { "key": "currency", "value": "USD" }
              ]
            }
          }
        },
        {
          "name": "Get Balance by Position (single)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ledger/balances?accountId={{account_id}}&balanceType=AVAILABLE_BALANCE&position=CURRENT&currency=USD",
              "host": ["{{base_url}}"], "path": ["ledger", "balances"],
              "query": [
                { "key": "accountId", "value": "{{account_id}}" },
                { "key": "balanceType", "value": "AVAILABLE_BALANCE" },
                { "key": "position", "value": "CURRENT" },
                { "key": "currency", "value": "USD" }
