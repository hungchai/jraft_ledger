          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "[\n  { \"accountId\": \"CLIENT_ACC_001\", \"balanceType\": \"AVAILABLE_BALANCE\", \"position\": \"CURRENT\", \"currency\": \"USD\" },\n  { \"accountId\": \"CLIENT_ACC_001\", \"balanceType\": \"AVAILABLE_BALANCE\", \"position\": \"LOCKED\", \"currency\": \"USD\" },\n  { \"accountId\": \"COMPANY_FX_ACC\", \"balanceType\": \"AVAILABLE_BALANCE\", \"position\": \"CURRENT\", \"currency\": \"USD\" }\n]"
            },
            "url": { "raw": "{{base_url}}/ledger/balances/batch", "host": ["{{base_url}}"], "path": ["ledger", "balances", "batch"] }
          }
        }
      ]
    },
    {
      "name": "Journal Query",
