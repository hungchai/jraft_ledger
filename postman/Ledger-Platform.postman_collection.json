              "raw": "{{base_url}}/ledger/balances/as-of?accountId={{account_id}}&balanceType=AVAILABLE_BALANCE&currency=USD&asOf=2026-05-15",
              "host": ["{{base_url}}"], "path": ["ledger", "balances", "as-of"],
              "query": [
                { "key": "accountId", "value": "{{account_id}}" },
