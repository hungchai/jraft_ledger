            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{request_id}}\",\n  \"reversalReason\": \"Test reversal\",\n  \"reversalReasonCode\": \"CANCELLATION\",\n  \"valueDate\": \"2026-05-18\"\n}"
            },
            "url": { "raw": "{{base_url}}/ledger/journals/{{journal_id}}/reversal", "host": ["{{base_url}}"], "path": ["ledger", "journals", "{{journal_id}}", "reversal"] }
