              "query": [
                { "key": "accountId", "value": "{{company_id}}" },
                { "key": "balanceType", "value": "AVAILABLE_BALANCE" },
                { "key": "currency", "value": "USD" }
              ]
            }
          }
        },
        {
          "name": "Get HKD Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ledger/balances?accountId={{account_id}}&balanceType=AVAILABLE_BALANCE&currency=HKD",
              "host": ["{{base_url}}"], "path": ["ledger", "balances"],
              "query": [
                { "key": "accountId", "value": "{{account_id}}" },
