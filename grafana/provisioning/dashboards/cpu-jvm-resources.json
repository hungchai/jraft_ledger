{
  "uid": "cpu-jvm-resources",
  "title": "CPU & JVM Resources",
  "tags": ["ledger", "resources"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Host CPU busy % (per core)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "100 - (rate(node_cpu_seconds_total{mode=\"idle\"}[30s]) * 100)",
        "legendFormat": "{{instance}} cpu{{cpu}}" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Host CPU by mode (steal / iowait / sys / user)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "avg by (instance, mode) (rate(node_cpu_seconds_total{mode=~\"steal|iowait|system|user|nice|irq|softirq\"}[30s])) * 100",
        "legendFormat": "{{instance}} {{mode}}" } ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Load avg & run-queue (runnable procs)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "node_load1", "legendFormat": "{{instance}} load1" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "node_procs_running", "legendFormat": "{{instance}} runnable" }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "JVM process CPU usage %",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "process_cpu_usage{job=\"ledger-nodes\"} * 100", "legendFormat": "{{instance}} process" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "system_cpu_usage{job=\"ledger-nodes\"} * 100", "legendFormat": "{{instance}} system" }
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "JVM heap (used / committed / max)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (instance) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "{{instance}} used" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (instance) (jvm_memory_committed_bytes{area=\"heap\"})", "legendFormat": "{{instance}} committed" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (instance) (jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "{{instance}} max" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "JVM non-heap used",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum by (instance) (jvm_memory_used_bytes{area=\"nonheap\"})", "legendFormat": "{{instance}} nonheap" } ]
    },
    {
      "id": 7, "type": "timeseries", "title": "GC pause: rate(sum) & max",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (instance) (rate(jvm_gc_pause_seconds_sum[30s]))", "legendFormat": "{{instance}} pause/s" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max by (instance) (jvm_gc_pause_seconds_max)", "legendFormat": "{{instance}} max" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "JVM live threads",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "jvm_threads_live_threads{job=\"ledger-nodes\"}", "legendFormat": "{{instance}} live" } ]
    },
    {
      "id": 9, "type": "timeseries", "title": "Posting / commit / apply — avg latency (ms)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(ledger_posting_duration_seconds_sum[30s])) / sum(rate(ledger_posting_duration_seconds_count[30s])) * 1000", "legendFormat": "posting e2e" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(ledger_raft_wait_apply_seconds_sum[30s])) / sum(rate(ledger_raft_wait_apply_seconds_count[30s])) * 1000", "legendFormat": "raft commit" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(ledger_apply_total_seconds_sum[30s])) / sum(rate(ledger_apply_total_seconds_count[30s])) * 1000", "legendFormat": "fsm apply" }
      ]
    }
  ]
}
