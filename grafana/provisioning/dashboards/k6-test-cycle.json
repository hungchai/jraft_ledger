        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Live view for `./scripts/test-cycle.sh` k6 stress runs. Watch end-to-end TPS, posting latency, Kafka lag, projection pipeline, GC, and MySQL while the test is running. Refresh: 5s."
      }
    },
    {
      "id": 2,
      "title": "API Posting TPS",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "pluginVersion": "12.0.1+security-01",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow"
              },
              {
                "color": "red"
              }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ledger_posting_duration_seconds_count{businessEventType=~\"$businessEventType\"}[1m]))",
          "legendFormat": "TPS"
