    {
      "id": 6,
      "title": "Posting E2E Latency (min / avg / max / P50 / P95 / P99)",
      "description": "k6 http_req_duration for POST /ledger/postings, successful responses only. avg = mean.",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "pluginVersion": "12.0.1+security-01",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow"
              },
              {
                "color": "red"
              }
            ]
          },
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "min",
            "max",
            "mean"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "min",
          "expr": "max(k6_http_req_duration_min{testid=~\"$testid\", name=~\".*/ledger/postings\", expected_response=\"true\"}) * 1000"
        },
        {
          "refId": "B",
          "legendFormat": "avg (mean)",
          "expr": "max(k6_http_req_duration_avg{testid=~\"$testid\", name=~\".*/ledger/postings\", expected_response=\"true\"}) * 1000"
        },
        {
          "refId": "C",
          "legendFormat": "max",
          "expr": "max(k6_http_req_duration_max{testid=~\"$testid\", name=~\".*/ledger/postings\", expected_response=\"true\"}) * 1000"
        },
        {
          "refId": "D",
          "legendFormat": "P50",
          "expr": "max(k6_http_req_duration_p50{testid=~\"$testid\", name=~\".*/ledger/postings\", expected_response=\"true\"}) * 1000"
        },
        {
          "refId": "E",
          "legendFormat": "P95",
          "expr": "max(k6_http_req_duration_p95{testid=~\"$testid\", name=~\".*/ledger/postings\", expected_response=\"true\"}) * 1000"
