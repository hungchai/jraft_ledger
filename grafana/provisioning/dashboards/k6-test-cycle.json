    {
      "id": 1,
      "type": "text",
      "title": "k6 Client E2E (test-cycle.sh)",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Client-side **end-to-end** metrics from k6 (`experimental-prometheus-rw`). Pick a **testid** from the dropdown (latest at top). **All** aggregates across runs. Latency: min / avg / max / P50 / P95 / P99 for `POST /ledger/postings`, successful responses only. **No data?** Widen time range or re-run `./scripts/test-cycle.sh` (min/avg/max need a new run)."
      }
    },
    {
      "id": 2,
      "title": "Posting Request Rate",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "pluginVersion": "12.0.1+security-01",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow"
              },
              {
                "color": "red"
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_http_reqs_total{testid=~\"$testid\", name=~\".*/ledger/postings\"}[1m]))",
          "legendFormat": "req/s"
        }
      ],
      "description": "HTTP requests/s to /ledger/postings"
    },
