{
  "uid": "ledger-perf-allinone",
  "title": "Ledger Perf — All-in-One",
  "tags": ["ledger", "perf"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    { "id": 100, "type": "row", "title": "Throughput & Latency", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 1, "type": "timeseries", "title": "Posting throughput (TPS)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum(rate(ledger_posting_duration_seconds_count[15s]))", "legendFormat": "posting/s" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Per-stage avg latency (ms)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(ledger_posting_duration_seconds_sum[30s]))/sum(rate(ledger_posting_duration_seconds_count[30s]))*1000", "legendFormat": "posting e2e" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(ledger_command_queue_wait_seconds_sum[30s]))/sum(rate(ledger_command_queue_wait_seconds_count[30s]))*1000", "legendFormat": "queue wait" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(ledger_raft_wait_apply_seconds_sum[30s]))/sum(rate(ledger_raft_wait_apply_seconds_count[30s]))*1000", "legendFormat": "raft commit" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(ledger_apply_total_seconds_sum[30s]))/sum(rate(ledger_apply_total_seconds_count[30s]))*1000", "legendFormat": "fsm apply" }
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Command queue depth",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "max(ledger_command_queue_depth)", "legendFormat": "queue depth" } ]
    },

    { "id": 200, "type": "row", "title": "Host CPU", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 } },
    {
      "id": 4, "type": "timeseries", "title": "CPU busy % (per core)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "100 - (rate(node_cpu_seconds_total{mode=\"idle\"}[30s]) * 100)", "legendFormat": "{{instance}} cpu{{cpu}}" } ]
    },
    {
      "id": 5, "type": "timeseries", "title": "CPU by mode (steal / iowait / sys / user)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "avg by (mode) (rate(node_cpu_seconds_total{mode=~\"steal|iowait|system|user\"}[30s])) * 100", "legendFormat": "{{mode}}" } ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Run-queue (runnable) & load1",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "node_procs_running", "legendFormat": "{{instance}} runnable" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "node_load1", "legendFormat": "{{instance}} load1" }
      ]
    },

    { "id": 300, "type": "row", "title": "JVM", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 } },
    {
      "id": 7, "type": "timeseries", "title": "JVM heap (used / committed / max)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (instance)(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "{{instance}} used" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (instance)(jvm_memory_committed_bytes{area=\"heap\"})", "legendFormat": "{{instance}} committed" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (instance)(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "{{instance}} max" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "GC pause (rate sum / max) & JVM CPU",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [
        { "matcher": { "id": "byName", "options": "process cpu %" }, "properties": [ { "id": "unit", "value": "percent" }, { "id": "custom.axisPlacement", "value": "right" } ] }
      ] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (instance)(rate(jvm_gc_pause_seconds_sum[30s]))", "legendFormat": "{{instance}} gc pause/s" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max by (instance)(jvm_gc_pause_seconds_max)", "legendFormat": "{{instance}} gc max" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "process_cpu_usage{job=\"ledger-nodes\"}*100", "legendFormat": "process cpu %" }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "JVM live threads",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "jvm_threads_live_threads{job=\"ledger-nodes\"}", "legendFormat": "{{instance}} threads" } ]
    },

    { "id": 400, "type": "row", "title": "Raft / Queue health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 } },
    {
      "id": 10, "type": "timeseries", "title": "Raft applied index & SM journal seq",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(ledger_raft_last_applied_index)", "legendFormat": "applied index" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(ledger_sm_journal_sequence)", "legendFormat": "sm journal seq" }
      ]
    },
    {
      "id": 11, "type": "timeseries", "title": "Posting rejections /s (by errorCode)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "sum by (errorCode)(rate(ledger_posting_rejected_count_total[30s]))", "legendFormat": "{{errorCode}}" } ]
    }
  ]
}
