{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Projection Pipeline — Kafka backlog & consume throughput",
  "uid": "projection-pipeline",
  "tags": ["ledger", "projection", "kafka"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Kafka backlog (consumergroup lag) — are messages piling up?",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 15, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(kafka_consumergroup_lag{consumergroup=\"ledger-projection\"})", "legendFormat": "total lag" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (topic) (kafka_consumergroup_lag{consumergroup=\"ledger-projection\"})", "legendFormat": "{{topic}}" }
      ]
    },
    {
      "id": 2,
      "title": "Produce vs Consume (events/s) — slope tells you if it keeps up",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "last"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(kafka_topic_partition_current_offset{topic=~\"ledger.*\"}[1m]))", "legendFormat": "produce → kafka" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(ledger_projection_events_processed[1m])", "legendFormat": "projection consume" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(ledger_projection_journal_flush_rows[1m])", "legendFormat": "journal rows → mysql" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(ledger_projection_balance_writes[1m])", "legendFormat": "balance upserts → mysql" }
      ]
    },
    {
      "id": 3,
      "title": "Projection consume rate (now)",
      "type": "stat",
      "gridPos": { "h": 9, "w": 6, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(ledger_projection_events_processed[1m])", "legendFormat": "events/s" }
      ]
    },
    {
      "id": 4,
      "title": "Stall detector — seconds since last event",
      "type": "stat",
      "gridPos": { "h": 9, "w": 6, "x": 18, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 30 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(ledger_projection_seconds_since_last_event_seconds)", "legendFormat": "idle s" }
      ]
    },
    {
      "id": 5,
      "title": "Upsert async queue depth (backpressure)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(ledger_projection_balance_upsert_queue_depth)", "legendFormat": "queue depth" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(ledger_projection_balance_upsert_rejected)", "legendFormat": "rejected" }
      ]
    },
    {
      "id": 6,
      "title": "MySQL write latency — mean per upsert batch (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "1000 * rate(ledger_projection_balance_upsert_duration_seconds_sum[1m]) / clamp_min(rate(ledger_projection_balance_upsert_duration_seconds_count[1m]), 1)", "legendFormat": "upsert mean ms" }
      ]
    },
    {
      "id": 7,
      "title": "Projection JVM CPU",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "process_cpu_usage{component=\"projection\"}", "legendFormat": "process cpu" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "system_cpu_usage{component=\"projection\"}", "legendFormat": "system cpu" }
      ]
    }
  ]
}
