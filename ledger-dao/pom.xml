    <dependencies>
        <dependency>
            <groupId>com.ibank</groupId>
            <artifactId>ledger-core</artifactId>
        </dependency>

        <!-- MyBatis Spring Boot -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
